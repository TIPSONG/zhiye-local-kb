# Copy to .env. Defaults are local; remote endpoints will receive document text.
RAG_LLM_URL=http://127.0.0.1:8080/v1
RAG_EMBED_URL=http://127.0.0.1:8081/v1
RAG_RERANK_URL=http://127.0.0.1:8082/v1
RAG_LLM_MODEL=local-chat
RAG_EMBED_MODEL=bge-m3
RAG_RERANK_MODEL=bge-reranker-v2-m3
RAG_LLM_API_KEY=
RAG_EMBED_API_KEY=
RAG_RERANK_API_KEY=
RAG_DOCUMENTS_DIR=documents
RAG_DB_PATH=data/knowledge.db
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_REQUEST_TIMEOUT=180
RAG_MAX_FILE_BYTES=52428800
